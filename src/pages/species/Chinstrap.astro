---
import * as Plot from "@observablehq/plot";
import PlotFigure from "../../components/PlotFigure.astro";
import penguins from "../../assets/penguins.json";

const penguinsChinstrap = penguins.filter(
  ({ species }) => species === "Chinstrap"
);

const plot = Plot.plot({
  title: "Pingouins Chinstrap",

  x: {
    label: "Longueur du bec (mm)"
  },

  y: {
    label: "Longueur de la nageoire (mm)"
  },

  marks: [
    Plot.dot(penguinsChinstrap, {
      x: "culmen_length_mm",
      y: "flipper_length_mm"
    })
  ]
});
---

<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Chinstrap</title>
  </head>

  <body>
    <nav>
      <a href="/">Accueil</a>
      <a href="/species/Adelie">Adelie</a>
      <a href="/species/Gentoo">Gentoo</a>
      <a href="/species/Chinstrap">Chinstrap</a>
    </nav>

    <main>
      <h1>Les pingouins Chinstrap</h1>

      <PlotFigure {plot} />
    </main>
  </body>
</html>