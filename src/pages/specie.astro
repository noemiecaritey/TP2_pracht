---
import GraphicSpecies from "../components/GraphicSpecies.astro";
import penguins from "../assets/penguins.json";
---

<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Les espèces de pingouins</title>
  </head>

  <body>
    <main>
      <h1>Les espèces de pingouins</h1>

      <section>
        <h2>Adelie</h2>

        <GraphicSpecies
          penguins={penguins}
          species="Adelie"
        />
      </section>

      <section>
        <h2>Gentoo</h2>

        <GraphicSpecies
          penguins={penguins}
          species="Gentoo"
        />
      </section>

      <section>
        <h2>Chinstrap</h2>

        <GraphicSpecies
          penguins={penguins}
          species="Chinstrap"
        />
      </section>
    </main>
  </body>
</html>