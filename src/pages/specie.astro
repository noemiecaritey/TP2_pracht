---
import GraphicSpecies from "../components/GraphicSpecies.astro";
import penguins from "../assets/penguins.json";
---

<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Les espèces de pingouins</title>
  </head>

  <body>
    <main>
      <h1>Les espèces de pingouins</h1>

      <!-- Menu avec ancres -->
      <nav>
        <a href="#adelie">Adelie</a>
        <a href="#gentoo">Gentoo</a>
        <a href="#chinstrap">Chinstrap</a>
      </nav>

      <!-- Graphique Adelie -->
      <section id="adelie">
        <h2>Adelie</h2>

        <GraphicSpecies
          penguins={penguins}
          species="Adelie"
        />
      </section>

      <!-- Graphique Gentoo -->
      <section id="gentoo">
        <h2>Gentoo</h2>

        <GraphicSpecies
          penguins={penguins}
          species="Gentoo"
        />
      </section>

      <!-- Graphique Chinstrap -->
      <section id="chinstrap">
        <h2>Chinstrap</h2>

        <GraphicSpecies
          penguins={penguins}
          species="Chinstrap"
        />
      </section>
    </main>
  </body>
</html>